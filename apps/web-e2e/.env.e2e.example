# 自定义 E2E 测试账号（可选配置，仅 cloud-sync-image-display.spec.ts 使用）
#
# 使用方式：
#   1. 复制本文件为 apps/web-e2e/.env.e2e.local（该文件已被 git 忽略，不会提交）；
#   2. 填入账号与密码（账号为 oa 小写登录名，密码为该账号真实密码）；
#   3. 运行：npx playwright test --project=functional src/functional/cloud-sync-image-display.spec.ts
#
# 也可直接用同名环境变量覆盖（优先级：环境变量 > 本文件）：
#   E2E_CUSTOM_ACCOUNT / E2E_CUSTOM_PASSWORD
#
# 未配置时，spec 中「自定义账号」用例自动跳过，预设账号池用例不受影响。
E2E_CUSTOM_ACCOUNT=
E2E_CUSTOM_PASSWORD=