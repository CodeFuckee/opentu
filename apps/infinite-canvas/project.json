{
  "name": "infinite-canvas",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/infinite-canvas/src",
  "implicitDependencies": ["web"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "VITE_BASE=/infinite/ ./node_modules/.bin/vite build",
        "cwd": "apps/infinite-canvas"
      },
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/web/infinite"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "./node_modules/.bin/tsc --noEmit",
        "cwd": "apps/infinite-canvas"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'infinite-canvas: 上游 bun 测试不移植(见 README);行为由 typecheck + 构建 + E2E smoke 守护'"
      }
    }
  }
}
