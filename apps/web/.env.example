# Supabase 连接配置（复制本文件为 apps/web/.env 后按需修改）
#
# apps/web 是 Vite 项目根目录，构建时从这里读取 import.meta.env.VITE_*。
# 未配置时，apps/web/src/supabase/supabase-client.ts 会回退到代码内的硬编码默认值。

# Supabase 网关地址
VITE_SUPABASE_URL=http://10.37.80.25:8021

# Supabase ANON key（公钥，仅浏览器端鉴权入口使用，不视为机密；
# 真正的安全控制在服务端 RLS / service_role）
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzg4MDY3NDU2LCJleHAiOjE3ODgwNzEwNTZ9.3Es1RvH8Xe_4wNCeI2vD8oCdKroHObwNodcm0d4cdes

# 注意：SERVICE_ROLE key（SUPABASE_SERVICE_ROLE_KEY）属于机密，绝不写进前端构建环境，
# 只配置在部署端 Supabase 容器环境变量 / secrets 中，详见 docs/supabase-keys.md