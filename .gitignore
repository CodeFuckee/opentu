# See http://help.github.com/ignore-files/ for more about ignoring files.

# ---- 构建产物（Vite / tsc / Nx 编译输出，匹配任意层级）----
dist
tmp
/out-tsc
# tsc 增量编译缓存（apps 与 packages 下 tsc -b 均可能生成）
*.tsbuildinfo

# ---- 依赖 ----
node_modules
.pnpm-store
# 本仓库用 pnpm 管理依赖（pnpm-lock.yaml 入库），npm 误生成的 lockfile 不入库
package-lock.json

# ---- Nx 本地缓存与运行数据 ----
.nx/cache
.nx/workspace-data

# ---- 测试与覆盖率产物（vitest / Playwright，匹配任意层级）----
coverage/
test-results/
playwright-report/

# ---- IDE / 编辑器 ----
# JetBrains（PyCharm 打开 services/segment-server 等场景的防御性规则）
/.idea
# VSCode：仅共享配置入库
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ---- 环境变量（含各子包本地 env，仅保留示例文件）----
.env
.env.*
!.env.example
!.env.e2e.example

# ---- 日志（含根目录 e2e-*.log / serve-*.log 等本地调试日志）----
*.log

# ---- 系统文件 ----
.DS_Store
Thumbs.db

# ---- Python（scripts/ 爬虫与 services/segment-server）----
__pycache__/
*.py[cod]
.pytest_cache/
venv/
.venv/

# ---- Supabase CLI 本地调试产物 ----
supabase/.temp/

# ---- 前端生成文件（构建产物，不入库）----
apps/web/public/sw.js
apps/web/public/sw.js.map
apps/web/public/user-manual/

# ---- E2E ----
# 视觉测试本地快照（含基线截图）
apps/web-e2e/src/visual
# 本机大体积测试素材不入库，仅保留已入库的 E2E fixture
test-files/*
!test-files/image-search-fixture.png
# CI E2E 本地调试产物（.ci-e2e-1774 / .ci-e2e-artifacts 等）
.ci-e2e-*

# 仓库内的独立实验项目（自带 node_modules/.next，非 opentu 源码）
feedbackland/

# ZCode 本地会话产物
.zcode/

# ---- 本地凭据与私有数据（勿提交）----
secret.md
data
.ua
# jzxz 素材爬虫本机配置（爬虫产物落在上方 data/ 内）
scripts/jzxz-crawler.local.json
